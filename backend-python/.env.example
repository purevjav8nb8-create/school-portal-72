# These variables belong in the backend service environment, never NEXT_PUBLIC_*.

# Cloudinary Admin API (API secret must remain server-side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Management API
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Supabase REST APIs; service-role key stays server-side and stores monthly Vercel usage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Render Metrics API; comma-separated service IDs (srv-...), sharing the 100 GB monthly bandwidth quota
RENDER_RESOURCE_ID=
RENDER_API_KEY=
